<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="example.UserMapper">
  <resultMap id="userWithDepartment" type="example.UserView">
    <id property="id" column="id"/>
    <association property="department" javaType="example.Department"/>
  </resultMap>
  <select id="findAll" resultMap="userWithDepartment">
    SELECT u.id, u.dept_id, d.id AS department_id
    FROM app_user u
    LEFT JOIN department d ON u.dept_id = d.id
  </select>
</mapper>

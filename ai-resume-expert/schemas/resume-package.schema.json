{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resume-package.schema.json",
  "title": "AI Resume Expert resume package",
  "description": "The deterministic gate input for a Markdown draft or final PDF handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "stage",
    "target",
    "timeline",
    "career_facts",
    "claims",
    "skills",
    "evidence_trace",
    "conflicts",
    "confidentiality_blockers",
    "markdown",
    "contact"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "resume_package" },
    "stage": { "type": "string", "enum": ["markdown_draft", "pdf_ready"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "level", "market", "language", "version_type"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "market": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "version_type": { "type": "string", "enum": ["role_baseline", "jd_tailored"] }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "organization", "role", "start", "end", "confirmed_by_user"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["employment", "internship", "education", "project"] },
          "organization": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "start": { "type": "string", "minLength": 1 },
          "end": { "type": "string", "minLength": 1 },
          "confirmed_by_user": { "type": "boolean" }
        }
      }
    },
    "career_facts": {
      "type": "array",
      "items": { "$ref": "evidence-record.schema.json" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    },
    "evidence_trace": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trace" }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "fact_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["unresolved", "resolved"] },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "resolution": { "type": "string", "minLength": 1 },
          "resolved_by_user": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "resolved" } },
              "required": ["status"]
            },
            "then": {
              "required": ["resolution", "resolved_by_user"],
              "properties": { "resolved_by_user": { "const": true } }
            }
          }
        ]
      }
    },
    "confidentiality_blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_by_user", "self_review"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "confirmed_at": { "type": "string", "format": "date-time" },
        "confirmed_by_user": { "type": "boolean" },
        "self_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "facts",
            "target_alignment",
            "confidentiality",
            "duplication",
            "length",
            "defensibility"
          ],
          "properties": {
            "facts": { "type": "boolean" },
            "target_alignment": { "type": "boolean" },
            "confidentiality": { "type": "boolean" },
            "duplication": { "type": "boolean" },
            "length": { "type": "boolean" },
            "defensibility": { "type": "boolean" }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmed_by_user"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "city": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "confirmed_by_user": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "stage": { "const": "pdf_ready" } },
        "required": ["stage"]
      },
      "then": {
        "properties": {
          "markdown": {
            "required": ["path", "sha256", "confirmed_at", "confirmed_by_user", "self_review"],
            "properties": { "confirmed_by_user": { "const": true } }
          },
          "contact": {
            "required": ["name", "phone", "email", "city", "confirmed_by_user"],
            "properties": { "confirmed_by_user": { "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "claim_type",
        "included",
        "fact_ids",
        "ownership_required",
        "ownership_confirmed",
        "disclosure_status",
        "interview_defensible"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "claim_type": {
          "type": "string",
          "enum": ["experience", "summary", "skill", "employment", "education", "project_fact", "other"]
        },
        "included": { "type": "boolean" },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ownership_required": { "type": "boolean" },
        "ownership_confirmed": { "type": "boolean" },
        "disclosure_status": {
          "type": "string",
          "enum": ["approved", "sanitized", "needs_redaction", "blocked", "unknown"]
        },
        "star": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "action", "result", "confirmed_by_user"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "action": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "confirmed_by_user": { "type": "boolean" }
          }
        },
        "quantification": { "$ref": "evidence-record.schema.json#/$defs/quantification" },
        "interview_defensible": { "type": "boolean" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "proficiency", "fact_ids", "confirmed_by_user"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "proficiency": { "type": "string", "enum": ["proficient", "familiar", "aware", "expert"] },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "confirmed_by_user": { "type": "boolean" },
        "expertise_confirmed_by_user": { "type": "boolean" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "fact_ids",
        "ownership_confirmed",
        "disclosure_status",
        "quantification_confirmed"
      ],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ownership_confirmed": { "type": "boolean" },
        "disclosure_status": { "type": "string", "enum": ["approved", "sanitized", "blocked"] },
        "quantification_confirmed": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
